# Copy this file to .env.local for local development.
# Never commit real values — .env and .env.local are gitignored.

# Postgres connection string. For local dev, matches docker-compose.yml.
# In production, use your hosted Postgres provider's connection string
# (prefer a pooled/pgbouncer endpoint if your provider offers one).
DATABASE_URL=postgres://zahran:devpassword@localhost:5544/zahran_portal

# Secret used to seal/encrypt the admin session cookie. Must be a long,
# random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse this value across environments (dev/prod should differ).
SESSION_SECRET=
