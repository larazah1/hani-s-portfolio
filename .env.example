# Copy this file to .env.local for local development.
# Never commit real values — .env and .env.local are gitignored.

# Neon Postgres connection string — use the POOLED endpoint (host contains
# "-pooler"). This app talks to Neon over HTTP (@neondatabase/serverless).
# Use a database/branch of its own: NOT the one the public site
# (zahran-portal) uses, whose publications/media tables have a different shape.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require

# docker-compose.yml is now optional. The Neon HTTP driver only talks to Neon
# (or a Neon-compatible HTTP proxy), so a plain local Postgres from
# docker-compose won't work with DATABASE_URL as-is — use a Neon dev branch.

# Secret used to seal/encrypt the admin session cookie. Must be a long,
# random string (32+ chars). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse this value across environments (dev/prod should differ).
SESSION_SECRET=
